# Copia este archivo:
#   cp .env.example .env                    (usado por docker-compose y por el backend)
#   cp .env.example frontend/.env.local      (usado por el frontend)

# General
NODE_ENV=development

# Backend (NestJS)
BACKEND_PORT=3001

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=kcbank
POSTGRES_PASSWORD=kcbank
POSTGRES_DB=kcbank

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# MinIO (compatible con S3)
MINIO_ROOT_USER=kcbank
MINIO_ROOT_PASSWORD=kcbank123
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=kc-bank

# Frontend (Next.js)
# URL pública del backend que consumirá el frontend
NEXT_PUBLIC_API_URL=http://localhost:3001
