# Variables usadas ÚNICAMENTE por docker-compose.yml para levantar la
# infraestructura local (PostgreSQL, Redis, MinIO).
#
# El backend y el frontend NO leen este archivo: tienen su propio
# .env.example en cada carpeta (backend/.env.example, frontend/.env.example).
#
# Uso:
#   cp .env.example .env

POSTGRES_USER=kcbank
POSTGRES_PASSWORD=kcbank
POSTGRES_DB=kcbank
POSTGRES_PORT=5432

REDIS_PORT=6379

MINIO_ROOT_USER=kcbank
MINIO_ROOT_PASSWORD=kcbank123
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
