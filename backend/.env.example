# Variables del backend (NestJS). Estos valores por defecto corresponden a
# la infraestructura levantada con `docker compose up -d` desde la raíz.
#
# Uso:
#   cp .env.example .env

NODE_ENV=development
BACKEND_PORT=3001

# Orígenes permitidos por CORS, separados por comas (sin espacios extra).
CORS_ORIGINS=http://localhost:3000

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=kcbank
POSTGRES_PASSWORD=kcbank
POSTGRES_DB=kcbank

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# MinIO (compatible con S3)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ROOT_USER=kcbank
MINIO_ROOT_PASSWORD=kcbank123
MINIO_USE_SSL=false
